# Server Configuration
PORT=4000
NODE_ENV=production

# Database Connection
MONGODB=your_mongodb_atlas_connection_string

# JWT Security
JWT_SC_TOKEN=your_secure_random_jwt_secret_key

# Gemini API
GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio

# Email Service (Nodemailer via Brevo/SMTP)
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SENDER_EMAIL=your_verified_sender_email_address

# Frontend URL
# For unified hosting, set this to your app's base URL (e.g., https://flashman.onrender.com)
# For split hosting, set this to your static frontend host (e.g., https://flashman.vercel.app)
FRONTEND_URL=http://localhost:5173
